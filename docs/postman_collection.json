      "description": "Examples of error handling and validation."
    },
    {
      "name": "Bulk Operations",
      "item": [
        {
          "name": "Create Multiple URLs",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This example shows how to create multiple URLs in sequence",
                  "// In a real scenario, you would send separate requests",
                  "",
                  "const urls = [",
                  "    {",
                  "        originalUrl: 'https://www.example.com/page1',",
                  "        title: 'Example Page 1',",
                  "        tags: ['bulk', 'example', 'page1']",
                  "    },",
                  "    {",
                  "        originalUrl: 'https://www.example.com/page2',",
                  "        title: 'Example Page 2',",
                  "        tags: ['bulk', 'example', 'page2']",
                  "    },",
                  "    {",
                  "        originalUrl: 'https://www.example.com/page3',",
                  "        title: 'Example Page 3',",
                  "        tags: ['bulk', 'example', 'page3']",
                  "    }",
                  "];",
                  "",
                  "// Store for use in request",
                  "pm.globals.set('bulkUrls', JSON.stringify(urls));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://www.example.com/bulk-page-{{$timestamp}}\",\n  \"title\": \"Bulk Created URL - {{$timestamp}}\",\n  \"tags\": [\"bulk\", \"example\", \"postman\"]\n}"
            },
            "url": {
              "raw": "{{baseURL}}/urls",
              "host": ["{{baseURL}}"],
              "path": ["urls"]
            },
            "description": "Example of creating URLs in bulk (run this request multiple times)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bulk URL created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.success).to.be.true;",
                  "});",
                  "",
                  "// Add delay to respect rate limits",
                  "setTimeout(function(){}, 100);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Examples of bulk operations and batch processing."
    }
  ]
