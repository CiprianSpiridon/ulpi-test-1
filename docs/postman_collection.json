        }
      ],
      "description": "URL redirection service endpoints."
    },
    {
      "name": "Error Handling Examples",
      "item": [
        {
          "name": "Invalid URL Creation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"not-a-valid-url\",\n  \"title\": \"Invalid URL Test\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/urls",
              "host": ["{{baseURL}}"],
              "path": ["urls"]
            },
            "description": "Test validation error with invalid URL."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation error returned', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.success).to.be.false;",
                  "    pm.expect(responseJson.error).to.equal('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-existent URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/urls/999999",
